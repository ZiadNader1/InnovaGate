{
  "version": 2,
  "outputDirectory": "dist/client/browser",
  "routes": [
    { "src": "/api/submissions", "dest": "/api/submissions.js" },
    { "src": "/api/submissions/(.*)", "dest": "/api/submissions.js" },
    { "src": "/api/(.*)", "dest": "/api/index.ts" },
    { "handle": "filesystem" },
    { "src": "/.*", "dest": "/index.html" }
  ]
}
